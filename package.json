{
	"name": "free-game",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "svartz dev",
		"build": "svartz build",
		"skills:sync": "node research/tools/sync-skills.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "biome check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@changesets/cli": "^3.0.3",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource/atkinson-hyperlegible-mono": "5.3.0",
		"@svartz/config": "2.3.0",
		"@svartz/vite": "2.3.0",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"marked": "18.1.3",
		"svartz": "2.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "4.156.2"
	}
}
